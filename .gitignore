docker-compose.override.yml

# Runtime data (hosted apps, previews, uploads)
data/
server/data/

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.local.json

# Test / coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo
